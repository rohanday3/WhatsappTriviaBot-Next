{
  "name": "whatsapp-trivia-next",
  "version": "3.10.5",
  "private": true,
  "description": "Concurrent WhatsApp trivia bot with group and direct games, durable leaderboards, and production-safe deployment",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "start:pair": "PAIRING_MODE=code node --disable-warning=ExperimentalWarning dist/index.js",
    "test": "tsx --test test/**/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "doctor": "node --disable-warning=ExperimentalWarning scripts/doctor.mjs",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "baileys": "7.0.0-rc13",
    "dotenv": "16.6.1",
    "pino": "9.7.0",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/qrcode-terminal": "0.12.2",
    "pino-pretty": "13.0.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  },
  "license": "MIT"
}
