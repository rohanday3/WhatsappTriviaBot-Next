# Bot identity
BOT_NAME=Quizzy
COMMAND_PREFIX=/
TIMEZONE=Africa/Johannesburg

# WhatsApp linking: qr or code
PAIRING_MODE=qr
# Required only when PAIRING_MODE=code; digits only, including country code
PAIRING_NUMBER=27821234567

# Runtime paths
DATABASE_PATH=./var/trivia.db
LOG_LEVEL=info

# Local health endpoint (bind to loopback unless you intentionally proxy it)
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8787

# Defaults for new chats
DEFAULT_QUESTIONS=10
DEFAULT_TIMEOUT_SECONDS=25
DEFAULT_REVEAL_DELAY_MS=2200
MAX_CONCURRENT_GAMES=250
MAX_OUTBOUND_QUEUE_PER_CHAT=50

# Trivia provider
TRIVIA_API_ENABLED=true
TRIVIA_API_TIMEOUT_MS=8000
TRIVIA_API_MIN_INTERVAL_MS=5500
TRIVIA_CACHE_TTL_MINUTES=360

# Global bot administrators, comma-separated. Use the administrators' own WhatsApp
# numbers (not the bot number), digits only with country code. Required for /health.
# Example: 27821234567,27829876543
BOT_ADMINS=
