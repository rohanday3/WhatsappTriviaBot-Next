# Bot identity
BOT_NAME=Quizzy
COMMAND_PREFIX=/
TIMEZONE=Africa/Johannesburg

# WhatsApp linking: qr or code
PAIRING_MODE=qr
# Required only when PAIRING_MODE=code; digits only, including country code
PAIRING_NUMBER=27821234567

# Runtime paths
DATABASE_PATH=./var/trivia.db
LOG_LEVEL=info

# Local health endpoint (bind to loopback unless you intentionally proxy it)
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8787

# Defaults for new chats
DEFAULT_QUESTIONS=10
DEFAULT_TIMEOUT_SECONDS=25
DEFAULT_REVEAL_DELAY_MS=2200
# Questions used in a chat are blocked from repeating there for this many hours.
# Each chat can override this with /set cooldown (for example /set cooldown 7d).
DEFAULT_QUESTION_COOLDOWN_HOURS=168
MAX_CONCURRENT_GAMES=250
MAX_OUTBOUND_QUEUE_PER_CHAT=50

# Trivia providers. TRIVIA_API_ENABLED is the master switch.
TRIVIA_API_ENABLED=true

# Primary provider: The Trivia API. An API key is optional for its public,
# non-commercial endpoint and required for commercial/premium use.
THE_TRIVIA_API_ENABLED=true
THE_TRIVIA_API_KEY=
THE_TRIVIA_API_MIN_INTERVAL_MS=250

# Emergency network fallback: Open Trivia DB.
OPENTDB_ENABLED=true
# OpenTDB requests are serialized and rate-limited with this interval.
TRIVIA_API_MIN_INTERVAL_MS=5500
TRIVIA_API_TIMEOUT_MS=8000

# The primary API accepts at most 20 questions in each request.
TRIVIA_FETCH_BATCH_SIZE=20
# Durable API questions are retained in SQLite across restarts, up to this limit.
TRIVIA_CACHE_MAX_QUESTIONS=20000
# Legacy setting retained for compatibility; the durable cache no longer expires on this timer.
TRIVIA_CACHE_TTL_MINUTES=360

# Global bot administrators, comma-separated. Use the administrators' own WhatsApp
# numbers (not the bot number), digits only with country code. Required for /health.
# Example: 27821234567,27829876543
BOT_ADMINS=
